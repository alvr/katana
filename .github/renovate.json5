{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base",
        ":disableDependencyDashboard",
        "helpers:pinGitHubActionDigests",
    ],
    "baseBranches": [
        "develop",
    ],
    "assignees": [
        "alvr",
    ],
    "reviewers": [
        "alvr",
    ],
    "prConcurrentLimit": 5,
    "prHourlyLimit": 3,
    "enabledManagers": [
        "gradle",
        "gradle-wrapper",
        "github-actions",
    ],
    "rebaseWhen": "behind-base-branch",
    "recreateWhen": "never",
    "packageRules": [
        {
            "groupName": "JetBrains AndroidX",
            "groupSlug": "jetbrains-androidx",
            "matchPackagePatterns": [
                "org.jetbrains.androidx.*",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Kotlin Dependants",
            "groupSlug": "kotlin",
            "matchPackagePrefixes": [
                "com.google.devtools.ksp",
                "dev.mokkery",
                "org.jetbrains.compose",
                "org.jetbrains.kotlinx",
            ],
            "matchPackagePatterns": [
                "org.jetbrains.kotlin.*",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Koin",
            "groupSlug": "koin",
            "matchPackagePrefixes": [
                "io.insert-koin",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Kotest",
            "groupSlug": "kotest",
            "matchPackagePrefixes": [
                "io.kotest",
                "io.kotest.extensions",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Apollo",
            "groupSlug": "apollo",
            "matchPackagePatterns": [
                "com.apollographql.*",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "GitHub Actions",
            "groupSlug": "github-actions",
            "matchManagers": ["github-actions"],
        },
        {
            "automerge": false,
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest",
            ],
        },
    ],
}
