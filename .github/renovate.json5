{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base",
        ":disableDependencyDashboard",
        "helpers:pinGitHubActionDigests",
    ],
    "baseBranches": [
        "develop",
    ],
    "assignees": [
        "alvr",
    ],
    "reviewers": [
        "alvr",
    ],
    "logLevel": "warn",
    "onboarding": false,
    "prConcurrentLimit": 5,
    "prHourlyLimit": 3,
    "enabledManagers": [
        "gradle",
        "github-actions",
    ],
    "rebaseWhen": "behind-base-branch",
    "recreateWhen": "never",
    "packageRules": [
        {
            "groupName": "Kotlin Dependants",
            "groupSlug": "kotlin",
            "matchPackagePrefixes": [
                "com.google.devtools.ksp",
                "dev.mokkery",
                "org.jetbrains.compose",
                "org.jetbrains.kotlinx",
            ],
            "matchPackagePatterns": [
                "org.jetbrains.kotlin.*",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Koin",
            "groupSlug": "koin",
            "matchPackagePrefixes": [
                "io.insert-koin",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Kotest",
            "groupSlug": "kotest",
            "matchPackagePrefixes": [
                "io.kotest",
                "io.kotest.extensions",
            ],
            "matchManagers": ["gradle"],
        },
        {
            "groupName": "Apollo",
            "groupSlug": "apollo",
            "matchPackagePatterns": [
                "com.apollographql.*",
            ],
            "matchManagers": ["gradle"]
        },
        {
            "groupName": "GitHub Actions",
            "groupSlug": "actions",
            "matchManagers": [
                "github-actions"
            ],
            matchUpdateTypes: [
                "digest",
                "pinDigest",
            ],
        },
        {
            "automerge": false,
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest",
            ],
        },
    ],
    "gradle": {
        "ignoreGradleLockFiles": true,
    },
}
