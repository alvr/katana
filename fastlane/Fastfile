default_platform(:android)

platform :android do
  desc "Build Android Debug APK"
  lane :build_debug do
    gradle(
      project_dir: ".",
      task: "assembleDebug",
      properties: { "katana.flavor" => "dev" },
    )
  end

  desc "Build & Deploy Android Beta APK"
  lane :build_deploy_beta do
    gradle(
      project_dir: ".",
      task: "assembleBeta",
      properties: { "katana.flavor" => "beta" },
    )
    commit = last_git_commit
    appcircle_testing_distribution(
      personalAPIToken: ENV["AC_PERSONAL_API_TOKEN"],
      profileName: ENV["AC_PROFILE_NAME"],
      appPath: lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH],
      message: commit[:message],
    )
  end

  desc "Build & Publish Android Release AAB"
  lane :build_deploy_release do
    gradle(
      project_dir: ".",
      task: "bundleRelease assembleRelease",
      properties: { "katana.flavor" => "release" },
    )
    upload_to_play_store(
      package_name: "dev.alvr.katana",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      track: "internal",
      release_status: "completed",
      mapping: "app-android/build/outputs/mapping/release/mapping.txt",
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT"],
      skip_upload_apk: true,
    )

    tag = ENV["GITHUB_REF_NAME"]
    changelog = changelog_from_git_commits(
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges",
    )

    assets = [
      lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH],
      lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
    ]

    existing = get_github_release(
      url: ENV["GITHUB_REPOSITORY"],
      version: tag,
      api_token: ENV["GITHUB_TOKEN"],
    )

    if existing
      assets.each do |asset|
        sh("gh", "release", "upload", tag, asset, "--clobber")
      end
    else
      set_github_release(
        repository_name: ENV["GITHUB_REPOSITORY"],
        api_token: ENV["GITHUB_TOKEN"],
        tag_name: tag,
        name: tag,
        description: changelog,
        upload_assets: assets,
      )
    end
  end
end

platform :ios do
  IOS_PROJECT = "app-ios/Katana.xcodeproj"
  IOS_SCHEME  = "Katana iOS"

  desc "Build iOS Debug"
  lane :build_debug do
    xcodebuild(
      project: IOS_PROJECT,
      scheme: IOS_SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      xcargs: "KATANA_FLAVOR=dev",
      build: true,
      clean: true,
    )
  end

  desc "Build and Deploy iOS Beta"
  lane :build_deploy_beta do
    build_ios_app(
      project: IOS_PROJECT,
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "ad-hoc",
      xcargs: "KATANA_FLAVOR=beta",
      clean: true,
    )
    commit = last_git_commit
    appcircle_testing_distribution(
      personalAPIToken: ENV["AC_PERSONAL_API_TOKEN"],
      profileName: ENV["AC_PROFILE_NAME"],
      appPath: lane_context[SharedValues::IPA_OUTPUT_PATH],
      message: commit[:message],
    )
  end

  desc "Build iOS Release"
  lane :build_deploy_release do
    build_ios_app(
      project: IOS_PROJECT,
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "KATANA_FLAVOR=release",
      clean: false,
    )
  end
end
